PROVIDER_MODE=free                 # real | free (demo miễn phí, không cần key) | fake
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # để trống = mặc định
OPENAI_ASR_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini       # Kiểm tra và đổi sang model hiện hành nếu cần
OPENAI_TTS_MODEL=tts-1
TTS_PROVIDER=azure                 # azure | openai | elevenlabs
WHISPER_MODEL=medium               # chế độ free: tiny|base|small|medium|large-v3
WHISPER_COMPUTE_TYPE=int8
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
ELEVENLABS_API_KEY=                # nhập trên giao diện web hoặc điền tại đây cho giọng Adam
ELEVENLABS_MODEL=eleven_turbo_v2_5 # hỗ trợ đầy đủ Tiếng Việt (vi) và Tiếng Anh (en)
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=../storage
FONTS_DIR=./assets/fonts
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=600
RETENTION_DAYS=14
CORS_ORIGINS=http://localhost:5173
DEFAULT_ORIG_VOLUME=0.05
WORKER_POLL_SEC=1.0
